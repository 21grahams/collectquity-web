# Copy to .env.local for local development. `npm run dev` uses .env.local; point it at the
# local practice Supabase (http://localhost:54321; phones on the same Wi-Fi reach it through
# the page's own address automatically). `npm run dev:live` reads .env.live.local
# (live project values) instead.
# Both values are public by design (they ship inside the app); data access
# requires logging in, and the database only answers to its allow-list.
# Find them in Supabase → Project Settings → API Keys.
VITE_SUPABASE_URL=https://zjtiggbmkrouceaqgfdw.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: URL path the app is served from (default /).
# VITE_BASE=/
